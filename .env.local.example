# URL del backend (Fase 1). En el mockup actual el front funciona sin API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Enlace de invitación a la comunidad de WhatsApp de Elevar.
NEXT_PUBLIC_WHATSAPP_COMUNIDAD_URL=https://chat.whatsapp.com/elevar-comunidad

# Cotización de referencia ARS→USD para mostrar precios en PayPal.
NEXT_PUBLIC_USD_RATE=1450

# PayPal queda contemplado en el alcance; poner "false" lo oculta del checkout
# si Elevar decide operar sólo con Mercado Pago.
NEXT_PUBLIC_PAYPAL_ENABLED=true
